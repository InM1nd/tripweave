# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Всё перечисленное ниже не должно попадать в GitHub (секреты, сборки, кэш, логи, локальные настройки).

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.lcov

# next.js
/.next/
/out/

# production
/build
/dist

# cache & turbo
.cache
.turbo
.eslintcache
.prettiercache
.parcel-cache

# misc — OS, бэкапы, временные
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.key
*.log
*~
*.bak
*.swp
*.tmp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lint_output.txt

# env — не коммитить (шаблон .env.example можно коммитить)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# Cursor / Claude — локальные настройки, не пушить на GitHub
.claude/
.claudeignore
.cursor/
.cursorignore
.cursorrules

# IDE — локальные настройки
.idea/
.vscode/
*.sublime-*

# секреты и локальные данные
.sentryclirc
*.sqlite
*.sqlite3
*.db
